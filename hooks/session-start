#!/usr/bin/env bash
# SessionStart hook for CodeGate — inject using-codegate automatically
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

using_content=$(cat "${PLUGIN_ROOT}/skills/using-codegate/SKILL.md" 2>&1 || echo "Error reading using-codegate skill")

escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

using_escaped=$(escape_for_json "$using_content")
session_context="<EXTREMELY_IMPORTANT>\nYou have CodeGate.\n\n**Below is the full content of 'codegate:using-codegate'. It is already loaded — do NOT reload it. For other CodeGate skills, use the Skill tool when the task matches their description.**\n\n${using_escaped}\n\n**User does NOT need magic phrases.** Natural coding requests (写功能/修bug/做完了/开PR) must route through CodeGate gates automatically.\n</EXTREMELY_IMPORTANT>"

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context" | cat
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat
else
  # Codex / Copilot CLI / unknown — SDK top-level additionalContext
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context" | cat
fi
exit 0
